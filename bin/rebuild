#!/usr/bin/env bash
# rebuild — nixos-rebuild switch + auto-commit + push.
# Bypasses pre-commit hooks (CHANGELOG, identity) for frictionless workflow.
set -euo pipefail

FLAKE="/etc/nixos"
HOST="$(grep -oP 'hostname\s*=\s*"\K[^"]+' "$FLAKE/machine.nix" 2>/dev/null || echo "hydragon2000-pc")"
SSH_KEY="$HOME/.ssh/id_ed25519_personal"

info()  { printf '\033[1;34m::\033[0m %s\n' "$*"; }
ok()    { printf '\033[1;32m✓\033[0m %s\n' "$*"; }
warn()  { printf '\033[1;33m!!\033[0m %s\n' "$*"; }
err()   { printf '\033[1;31mxx\033[0m %s\n' "$*" >&2; }

info "Building and switching ($FLAKE#$HOST) ..."
sudo nixos-rebuild switch --flake "$FLAKE#$HOST"
ok "Switch succeeded."

cd "$FLAKE"

if git diff --quiet; then
  ok "No changes — nothing to commit."
  exit 0
fi

info "Staging changes ..."
git add -u

UNTRACKED=$(git ls-files --others --exclude-standard)
if [ -n "$UNTRACKED" ]; then
  info "Untracked files present (not auto-staged):"
  printf '  %s\n' $UNTRACKED
fi

info "Generating commit message ..."
DIFF=$(git diff --cached)
MSG=$(printf '%s' "$DIFF" | python3 "$FLAKE/gen-commit-msg.py" 2>/dev/null || true)
if [ -z "$MSG" ]; then
  MSG="auto: rebuild $(date +%Y-%m-%d_%H:%M)"
fi

git diff --cached --stat
info "Committing: $MSG"
git commit --no-verify -m "$MSG"
ok "Committed."

info "Pushing to origin ..."
GIT_SSH_COMMAND="ssh -i $SSH_KEY -o IdentitiesOnly=yes" git push origin main
ok "Pushed."
