#!/usr/bin/env bash
# rebuild — nixos-rebuild switch + auto-commit + push.
# Bypasses pre-commit hooks (CHANGELOG, identity) for frictionless workflow.
#
# Tuning knobs (env vars):
#   REBUILD_SSH_KEY  path to SSH key for push (default: ~/.ssh/id_ed25519_personal)
#   ALLOW_HWCONFIG=1 allow committing hardware-configuration.nix
set -euo pipefail

FLAKE="${FLAKE:-/etc/nixos}"
cd "$FLAKE"

# --- hostname (machine.nix first, then env/hostname, then generic) ---
HOST="$(sed -n 's/.*hostname[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' machine.nix 2>/dev/null | head -n1)"
[ -z "$HOST" ] && HOST="${HOSTNAME:-$(hostname 2>/dev/null || echo)}"
[ -z "$HOST" ] && HOST="nixos"

# --- remote / branch (don't hardcode) ---
BRANCH="$(git branch --show-current 2>/dev/null || echo)"
BRANCH="${BRANCH:-main}"
REMOTE="$(git remote 2>/dev/null | head -n1 || echo)"
REMOTE="${REMOTE:-origin}"

# --- ssh key: override, else personal key, else ~/.ssh/config routing ---
SSH_KEY="${REBUILD_SSH_KEY:-$HOME/.ssh/id_ed25519_personal}"
PUSH_ENV=()
if [ -f "$SSH_KEY" ]; then
  PUSH_ENV=(GIT_SSH_COMMAND="ssh -i $SSH_KEY -o IdentitiesOnly=yes")
else
  PUSH_ENV=(GIT_SSH_COMMAND="ssh")
fi

info()  { printf '\033[1;34m::\033[0m %s\n' "$*"; }
ok()    { printf '\033[1;32m✓\033[0m %s\n' "$*"; }
warn()  { printf '\033[1;33m!!\033[0m %s\n' "$*"; }
err()   { printf '\033[1;31mxx\033[0m %s\n' "$*" >&2; }

info "Building and switching ($FLAKE#$HOST) ..."
sudo nixos-rebuild switch --flake "$FLAKE#$HOST"
ok "Switch succeeded."

# Detect changes including untracked files (git diff alone misses them).
if [ -z "$(git status --porcelain)" ]; then
  ok "No changes — nothing to commit."
  exit 0
fi

info "Staging changes (tracked + untracked) ..."
git add -A

# Guard: never commit hardware-configuration.nix unless explicitly allowed.
if git diff --cached --name-only | grep -qx 'hardware-configuration.nix' \
   && [ "${ALLOW_HWCONFIG:-0}" != "1" ]; then
  warn "Unstaging hardware-configuration.nix (set ALLOW_HWCONFIG=1 to include it)."
  git restore --staged hardware-configuration.nix
fi

info "Generating commit message ..."
MSG=""
if [ -f "$FLAKE/gen-commit-msg.py" ]; then
  DIFF=$(git diff --cached)
  MSG=$(printf '%s' "$DIFF" | python3 "$FLAKE/gen-commit-msg.py" 2>/dev/null || true)
fi
if [ -z "$MSG" ]; then
  MSG="auto: rebuild $(date +%Y-%m-%d_%H:%M)"
fi

git diff --cached --stat
info "Committing: $MSG"
git commit --no-verify -m "$MSG"
ok "Committed."

if [ -z "$(git remote get-url "$REMOTE" 2>/dev/null)" ]; then
  warn "No remote '$REMOTE' configured — skipping push."
  exit 0
fi

info "Pushing to $REMOTE/$BRANCH ..."
env "${PUSH_ENV[@]}" git push "$REMOTE" "$BRANCH"
ok "Pushed."
